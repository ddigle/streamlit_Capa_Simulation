# Normalize text files in the repository and use LF by default.
* text=auto eol=lf

# Source, configuration, and documentation files.
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Windows command scripts require CRLF for broad compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Office documents and other binary assets must never be normalized.
*.xls binary
*.xlsx binary
*.xlsm binary
*.xlsb binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
# 입장 화면의 부분 글꼴(components/intro_overlay_assets). 줄바꿈 정규화가 닿으면 글꼴이 깨진다.
*.woff2 binary
*.woff binary
