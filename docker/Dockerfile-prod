FROM artifactory.samsungds.net/devops-template-ahub-docker/baseimage/python:3.10-odbc2.8

ENV PATH $HOME/.local/bin:$PATH

RUN sudo mkdir /project
COPY . /project/
RUN sudo chown -R $DSUSER:$DSUSER /project

RUN pip install -U pip
RUN pip install -U setuptools
# 통합인증의 cryptography · cffi 는 휠만 받는다. 휠이 없으면 Rust 소스 빌드로 넘어가 멈추는 대신
# 「휠 없음」 으로 바로 실패해 원인이 보이게 한다.
RUN pip install -r /project/requirements.txt --no-cache-dir --only-binary=cryptography,cffi
# 두 DB 를 버킷에 올리고 받는 `aws`. 판 값은 `io/container_start_report.py` 의 `AWS_CLI_VERSION` 과 맞댄다.
# 앱 의존성이 아니라 이미지 도구라 `requirements.txt` · `uv.lock` 밖의 따로 된 한 줄이다 — 사외 개발
# 환경에 넣지 않는다. 사내 ECS 에서 잰 판이고, `python-dateutil` · `urllib3` 가 그 범위 안임을 시험이
# 지킨다(`tests/test_requirements_export.py`). 공개 미러로 받으므로 Artifactory 계정이 필요 없다.
RUN pip install awscli==1.46.3 --no-cache-dir

WORKDIR /project

# `src` 레이아웃이라 이 한 줄이 없으면 앱이 못 뜬다.
# `import capa_simulation` 은 `/project/src` 아래를 봐야 하는데, 개발 PC 는 editable
# 설치(`__editable__.capa_simulation-0.1.0.pth`)가 그 경로를 넣어 주고 pytest 는
# `pyproject.toml` 의 `pythonpath = ["src"]` 가 넣어 준다. 컨테이너에는 둘 다 없다 —
# `requirements.txt` 는 `--no-emit-project` 로 뽑아 **프로젝트 자신을 설치하지 않는다**
# (그래야 `WORKDIR` 앞의 `pip install` 이 `/` 를 패키지로 보지 않는다).
# 그 결과 `sys.path` 에는 `/project` 만 들어가고 `No module named 'capa_simulation'` 이 난다.
ENV PYTHONPATH=/project/src

# 컨테이너에는 브라우저도 입력도 없다. 첫 실행 이메일 안내와 브라우저 열기를 끈다.
ENV STREAMLIT_SERVER_HEADLESS=true

# 사내 bigdataquery 가 로그인 토큰을 찾는 자리. 앱은 `$DSUSER` 로 돌아(위 `sudo` 가 그 까닭이다)
# `/` 에 폴더를 만들 수 없으므로, 시작 스크립트가 토큰 파일을 쓸 수 있게 미리 만들어 넘겨준다.
RUN sudo mkdir -p /config/.credential \
    && sudo chown $DSUSER:$DSUSER /config/.credential \
    && sudo chmod 700 /config/.credential

# C-DEP CD 는 시작 명령을 바꿀 수 없고 서버 셸도 없다 — 배포 설정의 환경변수 표만 넣을 수 있다.
# 시작 스크립트가 맨 앞에서 8080 을 잡아 상태 검사에 답하고, 그 환경변수로 사내 bigdataquery 설치·
# 로그인 토큰 파일을 갖추고 두 DB 를 버킷에서 받은 뒤 결과를 `data/temp/container_start.json` 에
# 남기고(앱의 Admin Area 「서버 시작 점검」 이 읽는다) `streamlit run capa_server.py --server.port 8080`
# 으로 이 프로세스를 갈아 끼운다(`os.execvpe` — 신호·종료 동작이 앱을 바로 띄울 때와 같다). 어느 단계가
# 실패해도 앱은 뜬다 — `managed` 의 DB 받기만 예외로, 받지 못하면 임시 화면에 머문다. `capa_server.py`
# 는 `app.py` 를 `st.App` 으로 감싸 통합인증 경로·문지기를 붙인 진입점이다(`docs/sso_setup.md`).
CMD ["python", "scripts/container_start.py"]
