# Python
__pycache__/
*.py[cod]
*.pyd
*.so
.Python

# Virtual environments
.venv*/
venv/
env/

# Test, coverage, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Streamlit secrets
.streamlit/secrets.toml

# Environment variables
.env
.env.*
!.env.example

# Local Excel inputs and generated outputs
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/temp/*
!data/temp/.gitkeep
data/*.db
data/*.db-*
data/*.db.*.bak
data/*.duckdb
data/*.duckdb.*
*.xls
*.xlsx
*.xlsm
*.xlsb
~$*

# Logs
logs/*
!logs/.gitkeep
*.log

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# 로컬 미리보기 설정. 포트가 사람마다 달라 공유하지 않는다.
.claude/
