# Python
__pycache__/
*.py[cod]
*.pyd
*.so
.Python

# Virtual environments
.venv*/
venv/
env/

# Test, coverage, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Streamlit secrets
.streamlit/secrets.toml

# Environment variables
.env
.env.*
!.env.example

# Local Excel inputs and generated outputs
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/temp/*
!data/temp/.gitkeep
# 다른 데이터 폴더와 같은 규칙을 준다. 여기만 빠져 있어 실데이터가 커밋될 수 있었다.
data/sample/*
!data/sample/.gitkeep
data/*.db
data/*.db-*
data/*.db.*.bak
data/*.duckdb
data/*.duckdb.*
*.xls
*.xlsx
*.xlsm
*.xlsb
~$*

# Logs
logs/*
!logs/.gitkeep
*.log

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# 로컬 미리보기 설정. 포트가 사람마다 달라 공유하지 않는다.
.claude/

# 에이전트 런타임이 만드는 자리. `.agents/skills/` 는 `.venv` 안으로 향하는 심볼릭 링크라
# 커밋되면 받는 쪽에서 깨진 링크가 된다. 사내에서 이 규칙이 지워진 적이 있는데, 코드 정본이
# 사외이므로 여기 두어야 배포될 때마다 되살아난다.
.agents/

# 에이전트 런타임이 만드는 또 하나의 자리. 사내에서 이 경로 7개가 커밋된 적이 있는데,
# 세션 이어붙이기용 중간 산출물이라 저장소에 남을 이유가 없고 읽는 쪽을 헷갈리게 한다.
.omo/

# Codex 런타임이 만드는 자리. `.claude/` 와 짝이다 — 한쪽만 무시하면 병행 개발에서
# 한 에이전트의 런타임 산출물만 커밋돼 최상위 위생 검사가 깨진다. 폴더는 이미 있다.
.codex/

# 도구가 흘리는 임시 산출물. 이름이 매번 달라 목록으로 막을 수 없다.
*.tmp
imgtmp/
